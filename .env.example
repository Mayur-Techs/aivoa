# Copy this file to .env and never commit real values.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# gemma2-9b-it is retained for the assignment but Groq retired it in 2025.
# Use llama-3.1-8b-instant by default, or set this if the model becomes available.
GROQ_MODEL=llama-3.1-8b-instant

# Docker Compose supplies this value. SQLite is used automatically for a zero-setup local demo.
DATABASE_URL=postgresql+asyncpg://aivoa:aivoa@localhost:5432/aivoa
FRONTEND_ORIGIN=http://localhost:5173
