# Copy this file to .env and never commit real values.
# Groq (primary AI provider): https://console.groq.com/keys
GROQ_API_KEY=
# Groq model — openai/gpt-oss-20b is available on the free tier.
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (automatic fallback if Groq fails): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# The zero-setup local demo uses SQLite. Leave this unchanged unless you deliberately run PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./aivoa.db
FRONTEND_ORIGIN=http://localhost:5173
