# Copy this file to .env and never commit real values.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# gemma2-9b-it is retained for the assignment but Groq retired it in 2025.
# Use llama-3.1-8b-instant by default, or set this if the model becomes available.
GROQ_MODEL=llama-3.1-8b-instant

# The zero-setup local demo uses SQLite. Leave this unchanged unless you deliberately run PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./aivoa.db
FRONTEND_ORIGIN=http://localhost:5173
