# Copy this file to .env and never commit real values.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Groq model — llama-3.1-8b-instant was retired. Use openai/gpt-oss-20b (available on free tier).
GROQ_MODEL=openai/gpt-oss-20b

# The zero-setup local demo uses SQLite. Leave this unchanged unless you deliberately run PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./aivoa.db
FRONTEND_ORIGIN=http://localhost:5173
